<http://example.org/hi/ibm/ArtificialAgent/ai_factsheets_service> a hi:ArtificialAgent ;
    rdfs:label "AI FactSheets service"@en ;
    hi:hasCapability <http://example.org/hi/ibm/Capability/documentation_authoring>,

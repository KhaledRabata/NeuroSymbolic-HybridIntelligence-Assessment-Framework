    hi:performsExecution <http://example.org/hi/ibm/TaskExecution/s5_execution> .

<http://example.org/hi/ibm/ArtificialAgent/ai_factsheets> a hi:ArtificialAgent ;
    rdfs:label "AI FactSheets"@en ;

<http://example.org/hi/ibm/Goal/s1_goal> a hi:Goal ;
    rdfs:label "Ensure deployed predictive model remains accurate, fair, and explainable with an auditable lifecycle record"@en ;
    rdfs:comment "Ensure deployed predictive model remains accurate, fair, and explainable with an auditable lifecycle record"@en ;

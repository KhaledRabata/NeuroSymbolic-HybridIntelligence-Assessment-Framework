@prefix hi: <https://w3id.org/hi-ontology#> .
@prefix meta: <http://example.org/hi/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/hi/ibm/UseCase/s1> a hi:UseCase ;
    rdfs:label "S1 — Predictive Model Governance & Continuous Monitoring"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-003; E-006; E-009; E-014; E-017; E-021"@en ;
    meta:observedInferred "Observed (partial Inferred on closed-loop retraining automation)"@en ;
    hi:hasHITeam <http://example.org/hi/ibm/HITeam/s1_team> .

<http://example.org/hi/ibm/UseCase/s2> a hi:UseCase ;
    rdfs:label "S2 — RAG Application Quality Evaluation & Promotion-to-Production"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-008; E-015"@en ;
    meta:observedInferred "Observed"@en ;
    hi:hasHITeam <http://example.org/hi/ibm/HITeam/s2_team> .

<http://example.org/hi/ibm/UseCase/s3> a hi:UseCase ;
    rdfs:label "S3 — GenAI Use-Case Approval & Regulatory Risk Classification"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-001; E-003; E-007; E-008; E-010"@en ;
    meta:observedInferred "Observed (partial Inferred on resubmission loop)"@en ;
    hi:hasHITeam <http://example.org/hi/ibm/HITeam/s3_team> .

<http://example.org/hi/ibm/UseCase/s4> a hi:UseCase ;
    rdfs:label "S4 — Prompt Security Hardening via Automated Red-Teaming"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-012"@en ;
    meta:observedInferred "Observed"@en ;
    hi:hasHITeam <http://example.org/hi/ibm/HITeam/s4_team> .

<http://example.org/hi/ibm/UseCase/s5> a hi:UseCase ;
    rdfs:label "S5 — Multi-Agent (Agentic AI) Governance Across the Lifecycle"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-005; E-010; E-011; E-018"@en ;
    meta:observedInferred "Observed (partial Inferred on agent remediation loop)"@en ;
    hi:hasHITeam <http://example.org/hi/ibm/HITeam/s5_team> .

<http://example.org/hi/ibm/UseCase/s6> a hi:UseCase ;
    rdfs:label "S6 — Virtual Assistant Production Quality & Safety Monitoring"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-013"@en ;
    meta:observedInferred "Observed (partial Inferred on alert prioritization)"@en ;
    hi:hasHITeam <http://example.org/hi/ibm/HITeam/s6_team> .

<http://example.org/hi/ibm/UseCase/s7> a hi:UseCase ;
    rdfs:label "S7 — Governed AI-Assisted Candidate Screening and Interview Coordination"@en ;
    meta:confidence "Medium"@en ;
    meta:evidenceIDs "E-016"@en ;
    meta:observedInferred "Observed (Inferred on exact feedback mechanism and baseline dataset)"@en ;
    hi:hasHITeam <http://example.org/hi/ibm/HITeam/s7_team> .

<http://example.org/hi/ibm/UseCase/s8> a hi:UseCase ;
    rdfs:label "S8 — Enterprise Model Risk Governance (MRG) Across Multi-Cloud Third-Party Models"@en ;
    meta:confidence "Medium-High"@en ;
    meta:evidenceIDs "E-002; E-004; E-010; E-014; E-019; E-020; E-022"@en ;
    meta:observedInferred "Observed (Inferred on exact risk-oversight role title; primary MRG workflow doc inaccessible)"@en ;
    hi:hasHITeam <http://example.org/hi/ibm/HITeam/s8_team> .

<http://example.org/hi/ibm/kg> a owl:Ontology ;
    rdfs:label "HI Knowledge Graph — Ibm"@en ;
    rdfs:comment "ABox for the 'ibm' use case, generated by kg_builder.py from the Phase 1 extraction sheet TBox imported from the HI Ontology (https://w3id.org/hi-ontology#)"@en ;
    owl:imports hi: .

<http://example.org/hi/ibm/Evaluation/s1_evaluation> a hi:Evaluation ;
    rdfs:label "S1 — Predictive Model Governance & Continuous Monitoring — Evaluation"@en ;
    meta:hasDecisionPoint "Promote model to production; trigger remediation/retraining on alert; issue assignment/resolution"@en ;
    meta:hasFeedbackMechanism "Real-time threshold-breach alerts feed back to stakeholders for remediation"@en ;
    hi:hasMetricConcept <http://example.org/hi/ibm/Metric/accuracy>,
        <http://example.org/hi/ibm/Metric/disparate_impact>,
        <http://example.org/hi/ibm/Metric/drift_magnitude>,
        <http://example.org/hi/ibm/Metric/explanation_stability_metric>,
        <http://example.org/hi/ibm/Metric/latency>,
        <http://example.org/hi/ibm/Metric/precision>,
        <http://example.org/hi/ibm/Metric/recall>,
        <http://example.org/hi/ibm/Metric/statistical_parity_difference>,
        <http://example.org/hi/ibm/Metric/throughput> .

<http://example.org/hi/ibm/Evaluation/s2_evaluation> a hi:Evaluation ;
    rdfs:label "S2 — RAG Application Quality Evaluation & Promotion-to-Production — Evaluation"@en ;
    meta:hasDecisionPoint "Promote application to production; remediate a violated transaction"@en ;
    meta:hasFeedbackMechanism "Production payload logging continuously feeds new data back into the evaluation loop"@en ;
    hi:hasMetricConcept <http://example.org/hi/ibm/Metric/answer_relevance>,
        <http://example.org/hi/ibm/Metric/answer_similarity>,
        <http://example.org/hi/ibm/Metric/average_precision>,
        <http://example.org/hi/ibm/Metric/context_relevance>,
        <http://example.org/hi/ibm/Metric/faithfulness>,
        <http://example.org/hi/ibm/Metric/hit_rate>,
        <http://example.org/hi/ibm/Metric/ndcg>,
        <http://example.org/hi/ibm/Metric/retrieval_precision>,
        <http://example.org/hi/ibm/Metric/unsuccessful_requests> .

<http://example.org/hi/ibm/Evaluation/s3_evaluation> a hi:Evaluation ;
    rdfs:label "S3 — GenAI Use-Case Approval & Regulatory Risk Classification — Evaluation"@en ;
    meta:hasDecisionPoint "Approve/reject at each review stage; final go/no-go for development"@en ;
    meta:hasFeedbackMechanism "Rejected/conditionally-approved use cases likely returned to requester for revision (inferred)"@en ;
    hi:hasMetricConcept <http://example.org/hi/ibm/Metric/eu_ai_act_risk_category>,
        <http://example.org/hi/ibm/Metric/risk_score> .

<http://example.org/hi/ibm/Evaluation/s4_evaluation> a hi:Evaluation ;
    rdfs:label "S4 — Prompt Security Hardening via Automated Red-Teaming — Evaluation"@en ;
    meta:hasDecisionPoint "Whether hardened prompt clears deployment threshold; which mitigation to apply"@en ;
    meta:hasFeedbackMechanism "Recompute-after-hardening tight feedback cycle between human edit and AI re-evaluation"@en ;
    hi:hasMetricConcept <http://example.org/hi/ibm/Metric/adversarial_robustness_score>,
        <http://example.org/hi/ibm/Metric/prompt_leakage_risk_score> .

<http://example.org/hi/ibm/Evaluation/s5_evaluation> a hi:Evaluation ;
    rdfs:label "S5 — Multi-Agent (Agentic AI) Governance Across the Lifecycle — Evaluation"@en ;
    meta:hasDecisionPoint "Approve agent/tool for Governed Agentic Catalog; intervene on production metric breach"@en ;
    meta:hasFeedbackMechanism "Production alerts trigger human review; SME red-teaming findings feed back into hardening (partially inferred)"@en ;
    hi:hasMetricConcept <http://example.org/hi/ibm/Metric/answer_relevance>,
        <http://example.org/hi/ibm/Metric/answer_similarity>,
        <http://example.org/hi/ibm/Metric/average_precision>,
        <http://example.org/hi/ibm/Metric/completion_rate>,
        <http://example.org/hi/ibm/Metric/context_relevance>,
        <http://example.org/hi/ibm/Metric/cost>,
        <http://example.org/hi/ibm/Metric/faithfulness>,
        <http://example.org/hi/ibm/Metric/hap>,
        <http://example.org/hi/ibm/Metric/hit_rate>,
        <http://example.org/hi/ibm/Metric/pii>,
        <http://example.org/hi/ibm/Metric/prompt_injection>,
        <http://example.org/hi/ibm/Metric/reciprocal_rank>,
        <http://example.org/hi/ibm/Metric/safety>,
        <http://example.org/hi/ibm/Metric/tool_call_reliability>,
        <http://example.org/hi/ibm/Metric/unsuccessful_requests> .

<http://example.org/hi/ibm/Evaluation/s6_evaluation> a hi:Evaluation ;
    rdfs:label "S6 — Virtual Assistant Production Quality & Safety Monitoring — Evaluation"@en ;
    meta:hasDecisionPoint "Whether a breached metric requires a prompt change; alert prioritization (partially inferred)"@en ;
    meta:hasFeedbackMechanism "Alert to engineer review to prompt-engineer improvement to re-monitoring closed loop"@en ;
    hi:hasMetricConcept <http://example.org/hi/ibm/Metric/hap>,
        <http://example.org/hi/ibm/Metric/meteor>,
        <http://example.org/hi/ibm/Metric/pii>,
        <http://example.org/hi/ibm/Metric/readability>,
        <http://example.org/hi/ibm/Metric/rouge> .

<http://example.org/hi/ibm/Evaluation/s7_evaluation> a hi:Evaluation ;
    rdfs:label "S7 — Governed AI-Assisted Candidate Screening and Interview Coordination — Evaluation"@en ;
    meta:hasDecisionPoint "Which candidates are shortlisted for manager review; whether bias/drift signals require pipeline adjustment"@en ;
    meta:hasFeedbackMechanism "Continuous bias/drift monitoring feeding back into pipeline oversight (partially inferred mechanism)"@en ;
    hi:hasMetricConcept <http://example.org/hi/ibm/Metric/bias_drift_detection_status>,
        <http://example.org/hi/ibm/Metric/resume_screening_speed>,
        <http://example.org/hi/ibm/Metric/time_to_hire_reduction> .

<http://example.org/hi/ibm/Evaluation/s8_evaluation> a hi:Evaluation ;
    rdfs:label "S8 — Enterprise Model Risk Governance (MRG) Across Multi-Cloud Third-Party Models — Evaluation"@en ;
    meta:hasDecisionPoint "Model approval/production promotion; retraining trigger; compliance sign-off"@en ;
    meta:hasFeedbackMechanism "Production feedback automatically triggers retraining/review workflows with retained human risk oversight"@en ;
    hi:hasMetricConcept <http://example.org/hi/ibm/Metric/answer_relevance>,
        <http://example.org/hi/ibm/Metric/drift>,
        <http://example.org/hi/ibm/Metric/fairness_bias>,
        <http://example.org/hi/ibm/Metric/faithfulness>,
        <http://example.org/hi/ibm/Metric/human_rating_voting_score>,
        <http://example.org/hi/ibm/Metric/pii_hap>,
        <http://example.org/hi/ibm/Metric/rmse_mae_r2>,
        <http://example.org/hi/ibm/Metric/roc_recall>,
        <http://example.org/hi/ibm/Metric/shapley_lime_explainability>,
        <http://example.org/hi/ibm/Metric/unsuccessful_answer_rate> .

<http://example.org/hi/ibm/Interaction/s1_int01> a hi:Interaction ;
    rdfs:label "Data Scientist-OpenScale threshold configuration"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/business_analyst>,
        <http://example.org/hi/ibm/HumanAgent/data_scientist> .

<http://example.org/hi/ibm/Interaction/s1_int02> a hi:Interaction ;
    rdfs:label "Data Analyst-explainability engine review"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/business_analyst>,
        <http://example.org/hi/ibm/HumanAgent/data_analyst> .

<http://example.org/hi/ibm/Interaction/s1_int03> a hi:Interaction ;
    rdfs:label "stakeholder issue-tracking workflow"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/business_analyst>,
        <http://example.org/hi/ibm/HumanAgent/data_scientist> .

<http://example.org/hi/ibm/Interaction/s2_int01> a hi:Interaction ;
    rdfs:label "Validator-RAG circles UI drill-down"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/developer>,
        <http://example.org/hi/ibm/HumanAgent/validator> .

<http://example.org/hi/ibm/Interaction/s2_int02> a hi:Interaction ;
    rdfs:label "Validator-source-attribution explainability view"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/developer>,
        <http://example.org/hi/ibm/HumanAgent/validator> .

<http://example.org/hi/ibm/Interaction/s3_int01> a hi:Interaction ;
    rdfs:label "Multi-stage sequential review among requester and Legal/Data Protection/Brand/Stakeholder reviewers"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/business_stakeholder>,
        <http://example.org/hi/ibm/HumanAgent/legal_reviewer> .

<http://example.org/hi/ibm/Interaction/s4_int01> a hi:Interaction ;
    rdfs:label "Prompt Engineer-red-teaming evaluator iterative review-and-harden loop"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/ArtificialAgent/red_teaming_evaluator>,
        <http://example.org/hi/ibm/HumanAgent/prompt_engineer_application_engineer> .

<http://example.org/hi/ibm/Interaction/s5_int01> a hi:Interaction ;
    rdfs:label "SME-Agent observation/verification episode"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/agent_developer>,
        <http://example.org/hi/ibm/HumanAgent/subject_matter_expert_red_teamer> .

<http://example.org/hi/ibm/Interaction/s5_int02> a hi:Interaction ;
    rdfs:label "Developer-Governed Agentic Catalog tool selection"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/ArtificialAgent/governed_agentic_catalog>,
        <http://example.org/hi/ibm/HumanAgent/agent_developer> .

<http://example.org/hi/ibm/Interaction/s6_int01> a hi:Interaction ;
    rdfs:label "Engineer-watsonx.governance UI alert review"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/engineers>,
        <http://example.org/hi/ibm/HumanAgent/subject_matter_experts> .

<http://example.org/hi/ibm/Interaction/s6_int02> a hi:Interaction ;
    rdfs:label "end-user-Virtual Assistant conversation (monitored object)"@en ;
    rdfs:comment "monitored object"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/ArtificialAgent/virtual_assistant>,
        <http://example.org/hi/ibm/HumanAgent/subject_matter_experts> .

<http://example.org/hi/ibm/Interaction/s7_int01> a hi:Interaction ;
    rdfs:label "Candidate-IRIS voice screening conversation"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/hiring_managers>,
        <http://example.org/hi/ibm/HumanAgent/recruiters_talent_team> .

<http://example.org/hi/ibm/Interaction/s7_int02> a hi:Interaction ;
    rdfs:label "Recruiter-report card review"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/hiring_managers>,
        <http://example.org/hi/ibm/HumanAgent/recruiters_talent_team> .

<http://example.org/hi/ibm/Interaction/s7_int03> a hi:Interaction ;
    rdfs:label "HR Leader-pipeline dashboard"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/hiring_managers>,
        <http://example.org/hi/ibm/HumanAgent/recruiters_talent_team> .

<http://example.org/hi/ibm/Interaction/s8_int01> a hi:Interaction ;
    rdfs:label "Model Validator-evaluation dashboard approval"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/model_developer_prompt_engineer>,
        <http://example.org/hi/ibm/HumanAgent/model_requestor_owner> .

<http://example.org/hi/ibm/Interaction/s8_int02> a hi:Interaction ;
    rdfs:label "Model Risk Officer-compliance report generation"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/model_requestor_owner>,
        <http://example.org/hi/ibm/HumanAgent/model_risk_officer> .

<http://example.org/hi/ibm/Interaction/s8_int03> a hi:Interaction ;
    rdfs:label "end-user rating capture (Human Rating/Voting metric)"@en ;
    rdfs:comment "Human Rating/Voting metric"@en ;
    hi:hasAgentInvolved <http://example.org/hi/ibm/HumanAgent/model_developer_prompt_engineer>,
        <http://example.org/hi/ibm/HumanAgent/model_requestor_owner> .


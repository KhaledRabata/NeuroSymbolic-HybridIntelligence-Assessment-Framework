@prefix hi: <https://w3id.org/hi-ontology#> .
@prefix meta: <http://example.org/hi/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/hi/leapspace/UseCase/s1> a hi:UseCase ;
    rdfs:label "S1 — Departmental Literature Review Synthesis"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-001; E-003; E-005; E-007; E-010; E-013; E-014"@en ;
    meta:observedInferred "Observed (partial Inferred on finalize decision point)"@en ;
    hi:hasHITeam <http://example.org/hi/leapspace/HITeam/s1_team> .

<http://example.org/hi/leapspace/UseCase/s2> a hi:UseCase ;
    rdfs:label "S2 — Cross-Domain Onboarding for Unfamiliar Research Areas"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-001; E-010; E-013"@en ;
    meta:observedInferred "Observed (partial Inferred on pursue decision)"@en ;
    hi:hasHITeam <http://example.org/hi/leapspace/HITeam/s2_team> .

<http://example.org/hi/leapspace/UseCase/s3> a hi:UseCase ;
    rdfs:label "S3 — Multidisciplinary Evidence Synthesis for Sparse or Fragmented Literature"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-001; E-006; E-007; E-010; E-014"@en ;
    meta:observedInferred "Observed (partial Inferred on gap-interpretation decision)"@en ;
    hi:hasHITeam <http://example.org/hi/leapspace/HITeam/s3_team> .

<http://example.org/hi/leapspace/UseCase/s4> a hi:UseCase ;
    rdfs:label "S4 — Evidence-Strength Calibration and Hallucination Mitigation"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-001; E-007; E-008; E-009; E-010; E-014"@en ;
    meta:observedInferred "Observed"@en ;
    hi:hasHITeam <http://example.org/hi/leapspace/HITeam/s4_team> .

<http://example.org/hi/leapspace/UseCase/s5> a hi:UseCase ;
    rdfs:label "S5 — Cross-Disciplinary Connection-Finding and Author/Collaborator Search"@en ;
    meta:confidence "Medium-High"@en ;
    meta:evidenceIDs "E-001; E-008; E-010; E-013"@en ;
    meta:observedInferred "Observed (Inferred on outreach decision and feedback mechanism)"@en ;
    hi:hasHITeam <http://example.org/hi/leapspace/HITeam/s5_team> .

<http://example.org/hi/leapspace/UseCase/s6> a hi:UseCase ;
    rdfs:label "S6 — Research-to-Funding Opportunity Matching"@en ;
    meta:confidence "Medium"@en ;
    meta:evidenceIDs "E-002; E-005; E-010"@en ;
    meta:observedInferred "Observed (Inferred on decision point and feedback mechanism; grant-count figures vary across sources)"@en ;
    hi:hasHITeam <http://example.org/hi/leapspace/HITeam/s6_team> .

<http://example.org/hi/leapspace/UseCase/s7> a hi:UseCase ;
    rdfs:label "S7 — AI-Assisted Argument Testing and Draft Strengthening"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-001; E-002; E-004; E-008; E-009; E-011; E-015"@en ;
    meta:observedInferred "Observed (partial Inferred on incorporation decision)"@en ;
    hi:hasHITeam <http://example.org/hi/leapspace/HITeam/s7_team> .

<http://example.org/hi/leapspace/UseCase/s8> a hi:UseCase ;
    rdfs:label "S8 — Governed Evidence Verification for Corporate and Regulated R&D"@en ;
    meta:confidence "Medium-High"@en ;
    meta:evidenceIDs "E-003; E-008; E-011; E-015; E-016; E-017"@en ;
    meta:observedInferred "Observed (Inferred on regulatory role title and decision point)"@en ;
    hi:hasHITeam <http://example.org/hi/leapspace/HITeam/s8_team> .

<http://example.org/hi/leapspace/kg> a owl:Ontology ;
    rdfs:label "HI Knowledge Graph — Leapspace"@en ;
    rdfs:comment "ABox for the 'leapspace' use case, generated by kg_builder.py from the Phase 1 extraction sheet TBox imported from the HI Ontology (https://w3id.org/hi-ontology#)"@en ;
    owl:imports hi: .

<http://example.org/hi/leapspace/Capability/private_secure_session_handling> a hi:Capability ;
    rdfs:label "private/secure session handling"@en .

<http://example.org/hi/leapspace/Evaluation/s1_evaluation> a hi:Evaluation ;
    rdfs:label "S1 — Departmental Literature Review Synthesis — Evaluation"@en ;
    meta:hasDecisionPoint "Whether synthesized review is comprehensive enough to finalize; which sources to foreground"@en ;
    meta:hasFeedbackMechanism "Iterative follow-up questioning within same conversation"@en ;
    hi:hasMetricConcept <http://example.org/hi/leapspace/Metric/not_separately_named_beyond_general_trust_card_citation_mechanism> .

<http://example.org/hi/leapspace/Evaluation/s2_evaluation> a hi:Evaluation ;
    rdfs:label "S2 — Cross-Domain Onboarding for Unfamiliar Research Areas — Evaluation"@en ;
    meta:hasDecisionPoint "Whether to pursue newly discovered topic synergy or collaboration lead"@en ;
    meta:hasFeedbackMechanism "Follow-up-question loop within same conversational context"@en ;
    hi:hasMetricConcept <http://example.org/hi/leapspace/Metric/not_explicitly_named_beyond_general_citation_trust_grounding> .

<http://example.org/hi/leapspace/Evaluation/s3_evaluation> a hi:Evaluation ;
    rdfs:label "S3 — Multidisciplinary Evidence Synthesis for Sparse or Fragmented Literature — Evaluation"@en ;
    meta:hasDecisionPoint "Whether an evidence gap is a genuine opportunity or an indexing artifact; how to weight contradicting sources"@en ;
    meta:hasFeedbackMechanism "Claim Radar signals when insufficient data exists, prompting question adjustment"@en ;
    hi:hasMetricConcept <http://example.org/hi/leapspace/Metric/source_count_considered>,
        <http://example.org/hi/leapspace/Metric/support_contradict_mixed_source_classification_counts> .

<http://example.org/hi/leapspace/Evaluation/s4_evaluation> a hi:Evaluation ;
    rdfs:label "S4 — Evidence-Strength Calibration and Hallucination Mitigation — Evaluation"@en ;
    meta:hasDecisionPoint "Whether to accept, qualify, or discard a specific AI-generated claim"@en ;
    meta:hasFeedbackMechanism "None automatic; loop closed entirely by human judgment reviewing Trust Card/Claim Radar evidence"@en ;
    hi:hasMetricConcept <http://example.org/hi/leapspace/Metric/claim_to_passage_alignment>,
        <http://example.org/hi/leapspace/Metric/mandatory_citation_guarantee>,
        <http://example.org/hi/leapspace/Metric/support_contradict_mixed_classification> .

<http://example.org/hi/leapspace/Evaluation/s5_evaluation> a hi:Evaluation ;
    rdfs:label "S5 — Cross-Disciplinary Connection-Finding and Author/Collaborator Search — Evaluation"@en ;
    meta:hasDecisionPoint "Whether to reach out to an identified potential collaborator; which cross-disciplinary connection to pursue"@en ;
    meta:hasFeedbackMechanism "Not explicitly described beyond general iterative-query pattern"@en ;
    hi:hasMetricConcept <http://example.org/hi/leapspace/Metric/relevance_ranking_with_small_recency_boost_publisher_discipline_neutral> .

<http://example.org/hi/leapspace/Evaluation/s6_evaluation> a hi:Evaluation ;
    rdfs:label "S6 — Research-to-Funding Opportunity Matching — Evaluation"@en ;
    meta:hasDecisionPoint "Which matched funding opportunity to pursue and apply for"@en ;
    meta:hasFeedbackMechanism "Not explicitly described"@en ;
    hi:hasMetricConcept <http://example.org/hi/leapspace/Metric/not_explicitly_named> .

<http://example.org/hi/leapspace/Evaluation/s7_evaluation> a hi:Evaluation ;
    rdfs:label "S7 — AI-Assisted Argument Testing and Draft Strengthening — Evaluation"@en ;
    meta:hasDecisionPoint "Which surfaced gaps or counter-evidence to incorporate into revised draft"@en ;
    meta:hasFeedbackMechanism "Iterative dialogue loop itself is the feedback mechanism"@en ;
    hi:hasMetricConcept <http://example.org/hi/leapspace/Metric/not_separately_named>,
        <http://example.org/hi/leapspace/Metric/relies_on_same_citation_grounding_mechanism_as_trust_cards> .

<http://example.org/hi/leapspace/Evaluation/s8_evaluation> a hi:Evaluation ;
    rdfs:label "S8 — Governed Evidence Verification for Corporate and Regulated R&D — Evaluation"@en ;
    meta:hasDecisionPoint "Whether compared studies provide sufficient/consistent evidence to proceed; what proprietary content is safe to upload"@en ;
    meta:hasFeedbackMechanism "Not explicitly described beyond standing privacy/non-training guarantee"@en ;
    hi:hasMetricConcept <http://example.org/hi/leapspace/Metric/implicit_time_savings>,
        <http://example.org/hi/leapspace/Metric/traceable_citation_audit_trail> .

<http://example.org/hi/leapspace/Interaction/s1_int01> a hi:Interaction ;
    rdfs:label "Researcher-LeapSpace multi-turn conversation (~5-exchange memory)"@en ;
    rdfs:comment "~5-exchange memory"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/HumanAgent/academic_researcher_faculty_member>,
        <http://example.org/hi/leapspace/HumanAgent/course_instructor> .

<http://example.org/hi/leapspace/Interaction/s2_int01> a hi:Interaction ;
    rdfs:label "Multi-turn natural-language dialogue"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/natural_language_query_interpreter_and_response_engine>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_phd_student_entering_new_field> .

<http://example.org/hi/leapspace/Interaction/s2_int02> a hi:Interaction ;
    rdfs:label "query refinement from broad to targeted question"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/natural_language_query_interpreter_and_response_engine>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_phd_student_entering_new_field> .

<http://example.org/hi/leapspace/Interaction/s3_int01> a hi:Interaction ;
    rdfs:label "Researcher reviewing Deep Research report"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/HumanAgent/nonprofit_chief_science_officer>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_examining_complex_multidisciplinary_question> .

<http://example.org/hi/leapspace/Interaction/s3_int02> a hi:Interaction ;
    rdfs:label "researcher clicking Claim Radar shield icon and reviewing category tabs"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/HumanAgent/nonprofit_chief_science_officer>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_examining_complex_multidisciplinary_question> .

<http://example.org/hi/leapspace/Interaction/s4_int01> a hi:Interaction ;
    rdfs:label "Researcher-Trust Card UI review"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/trust_card_generator>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_validating_a_specific_claim_or_assertion> .

<http://example.org/hi/leapspace/Interaction/s4_int02> a hi:Interaction ;
    rdfs:label "researcher-Claim Radar panel review"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/claim_radar>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_validating_a_specific_claim_or_assertion> .

<http://example.org/hi/leapspace/Interaction/s5_int01> a hi:Interaction ;
    rdfs:label "Researcher reviewing ranked results list"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/hybrid_keyword_semantic_search_engine>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_seeking_cross_disciplinary_connections_or_collaborators> .

<http://example.org/hi/leapspace/Interaction/s5_int02> a hi:Interaction ;
    rdfs:label "researcher reviewing author profile results"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/hybrid_keyword_semantic_search_engine>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_seeking_cross_disciplinary_connections_or_collaborators> .

<http://example.org/hi/leapspace/Interaction/s6_int01> a hi:Interaction ;
    rdfs:label "Researcher reviewing Find Funding filtered results list"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/find_funding_funding_discovery_engine>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_or_research_office_staff_searching_for_funding> .

<http://example.org/hi/leapspace/Interaction/s6_int02> a hi:Interaction ;
    rdfs:label "researcher reviewing funder eligibility pages"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/find_funding_funding_discovery_engine>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_or_research_office_staff_searching_for_funding> .

<http://example.org/hi/leapspace/Interaction/s7_int01> a hi:Interaction ;
    rdfs:label "Multi-turn 'challenge' dialogue between researcher and Writing Coach"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/writing_coach_dialogue_engine>,
        <http://example.org/hi/leapspace/HumanAgent/researcher_author_drafting_a_paper_proposal_or_thesis> .

<http://example.org/hi/leapspace/Interaction/s8_int01> a hi:Interaction ;
    rdfs:label "R&D scientist-Reading Assistant conversational interrogation"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/reading_assistant>,
        <http://example.org/hi/leapspace/HumanAgent/corporate_r_d_scientist> .

<http://example.org/hi/leapspace/Interaction/s8_int02> a hi:Interaction ;
    rdfs:label "R&D scientist-Compare Experiments table"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/ArtificialAgent/compare_experiments>,
        <http://example.org/hi/leapspace/HumanAgent/corporate_r_d_scientist> .

<http://example.org/hi/leapspace/Interaction/s8_int03> a hi:Interaction ;
    rdfs:label "library manager-platform support role"@en ;
    hi:hasAgentInvolved <http://example.org/hi/leapspace/HumanAgent/corporate_r_d_scientist>,
        <http://example.org/hi/leapspace/HumanAgent/library_information_services_manager> .

<http://example.org/hi/leapspace/Metric/claim_to_passage_alignment> a skos:Concept ;
    skos:prefLabel "claim-to-passage alignment"@en .

<http://example.org/hi/leapspace/Metric/implicit_time_savings> a skos:Concept ;
    skos:prefLabel "implicit time-savings (qualitative)"@en .

<http://example.org/hi/leapspace/Metric/mandatory_citation_guarantee> a skos:Concept ;
    skos:prefLabel "Mandatory-citation guarantee (>=1 reference per claim)"@en .

<http://example.org/hi/leapspace/Metric/not_explicitly_named> a skos:Concept ;
    skos:prefLabel "Not explicitly named (matching/filtering task)"@en .

<http://example.org/hi/leapspace/Metric/not_explicitly_named_beyond_general_citation_trust_grounding> a skos:Concept ;
    skos:prefLabel "Not explicitly named beyond general citation/trust grounding"@en .

<http://example.org/hi/leapspace/Metric/not_separately_named> a skos:Concept ;
    skos:prefLabel "Not separately named"@en .

<http://example.org/hi/leapspace/Metric/not_separately_named_beyond_general_trust_card_citation_mechanism> a skos:Concept ;
    skos:prefLabel "Not separately named beyond general Trust Card citation mechanism"@en .

<http://example.org/hi/leapspace/Metric/relevance_ranking_with_small_recency_boost_publisher_discipline_neutral> a skos:Concept ;
    skos:prefLabel "Relevance ranking with small recency boost, publisher/discipline-neutral"@en .

<http://example.org/hi/leapspace/Metric/relies_on_same_citation_grounding_mechanism_as_trust_cards> a skos:Concept ;
    skos:prefLabel "relies on same citation-grounding mechanism as Trust Cards"@en .

<http://example.org/hi/leapspace/Metric/source_count_considered> a skos:Concept ;
    skos:prefLabel "source count considered (up to 40 Claim Radar, up to 300 Deep Research)"@en .

<http://example.org/hi/leapspace/Metric/support_contradict_mixed_classification> a skos:Concept ;
    skos:prefLabel "support/contradict/mixed classification"@en .

<http://example.org/hi/leapspace/Metric/support_contradict_mixed_source_classification_counts> a skos:Concept ;
    skos:prefLabel "Support/Contradict/Mixed source-classification counts"@en .

<http://example.org/hi/leapspace/Metric/traceable_citation_audit_trail> a skos:Concept ;
    skos:prefLabel "Traceable-citation audit trail (qualitative)"@en .

<http://example.org/hi/leapspace/ArtificialAgent/author_search_collaborator_identification_engine> a hi:ArtificialAgent ;
    rdfs:label "Author Search/collaborator-identification engine"@en ;
    hi:hasCapability <http://example.org/hi/leapspace/Capability/author_collaborator_identification>,
        <http://example.org/hi/leapspace/Capability/cross_disciplinary_indexing>,
        <http://example.org/hi/leapspace/Capability/hybrid_keyword_semantic_search> ;
    hi:isAssignedToTask <http://example.org/hi/leapspace/Task/s5_at01>,
        <http://example.org/hi/leapspace/Task/s5_at02>,
        <http://example.org/hi/leapspace/Task/s5_at03> ;
    hi:operatesInContext <http://example.org/hi/leapspace/Context/s5_context> ;
    hi:performsExecution <http://example.org/hi/leapspace/TaskExecution/s5_execution> .

<http://example.org/hi/leapspace/ArtificialAgent/claim_radar_evaluation_engine> a hi:ArtificialAgent ;
    rdfs:label "Claim Radar evaluation engine"@en ;
    hi:hasCapability <http://example.org/hi/leapspace/Capability/blended_internal_external_document_analysis>,
        <http://example.org/hi/leapspace/Capability/claim_level_evidence_classification>,
        <http://example.org/hi/leapspace/Capability/multi_source_agentic_synthesis> ;
    hi:isAssignedToTask <http://example.org/hi/leapspace/Task/s3_at01>,
        <http://example.org/hi/leapspace/Task/s3_at02>,
        <http://example.org/hi/leapspace/Task/s3_at03> ;
    hi:operatesInContext <http://example.org/hi/leapspace/Context/s3_context> ;
    hi:performsExecution <http://example.org/hi/leapspace/TaskExecution/s3_execution> .

<http://example.org/hi/leapspace/ArtificialAgent/conversational_summarization_engine> a hi:ArtificialAgent ;
    rdfs:label "Conversational summarization engine (Standard mode)"@en ;
    hi:hasCapability <http://example.org/hi/leapspace/Capability/large_scale_literature_retrieval>,
        <http://example.org/hi/leapspace/Capability/summarization>,
        <http://example.org/hi/leapspace/Capability/tabular_flowchart_visualization> ;
    hi:isAssignedToTask <http://example.org/hi/leapspace/Task/s1_at01>,
        <http://example.org/hi/leapspace/Task/s1_at02>,
        <http://example.org/hi/leapspace/Task/s1_at03> ;
    hi:operatesInContext <http://example.org/hi/leapspace/Context/s1_context> ;
    hi:performsExecution <http://example.org/hi/leapspace/TaskExecution/s1_execution> .

<http://example.org/hi/leapspace/ArtificialAgent/deep_research_agentic_synthesis_engine> a hi:ArtificialAgent ;
    rdfs:label "Deep Research agentic synthesis engine (up to 300 sources)"@en ;
    hi:hasCapability <http://example.org/hi/leapspace/Capability/blended_internal_external_document_analysis>,
        <http://example.org/hi/leapspace/Capability/claim_level_evidence_classification>,
        <http://example.org/hi/leapspace/Capability/multi_source_agentic_synthesis> ;
    hi:isAssignedToTask <http://example.org/hi/leapspace/Task/s3_at01>,
        <http://example.org/hi/leapspace/Task/s3_at02>,
        <http://example.org/hi/leapspace/Task/s3_at03> ;
    hi:operatesInContext <http://example.org/hi/leapspace/Context/s3_context> ;
    hi:performsExecution <http://example.org/hi/leapspace/TaskExecution/s3_execution> .

<http://example.org/hi/leapspace/ArtificialAgent/deep_research_report_generator> a hi:ArtificialAgent ;
    rdfs:label "Deep Research report generator"@en ;
    hi:hasCapability <http://example.org/hi/leapspace/Capability/large_scale_literature_retrieval>,
        <http://example.org/hi/leapspace/Capability/summarization>,
        <http://example.org/hi/leapspace/Capability/tabular_flowchart_visualization> ;
    hi:isAssignedToTask <http://example.org/hi/leapspace/Task/s1_at01>,
        <http://example.org/hi/leapspace/Task/s1_at02>,
        <http://example.org/hi/leapspace/Task/s1_at03> ;
    hi:operatesInContext <http://example.org/hi/leapspace/Context/s1_context> ;
    hi:performsExecution <http://example.org/hi/leapspace/TaskExecution/s1_execution> .

<http://example.org/hi/leapspace/ArtificialAgent/trust_card_citation_traceability_engine> a hi:ArtificialAgent ;
    rdfs:label "Trust Card/citation-traceability engine"@en ;
    hi:hasCapability <http://example.org/hi/leapspace/Capability/enterprise_grade_encryption_and_data_non_retention>,
        <http://example.org/hi/leapspace/Capability/single_document_deep_analysis>,
        <http://example.org/hi/leapspace/Capability/structured_multi_study_comparison> ;
    hi:isAssignedToTask <http://example.org/hi/leapspace/Task/s8_at01>,
        <http://example.org/hi/leapspace/Task/s8_at02>,
        <http://example.org/hi/leapspace/Task/s8_at03> ;
    hi:operatesInContext <http://example.org/hi/leapspace/Context/s8_context> ;
    hi:performsExecution <http://example.org/hi/leapspace/TaskExecution/s8_execution> .

<http://example.org/hi/leapspace/Capability/experience_level_adaptive_response_generation> a hi:Capability ;
    rdfs:label "experience-level-adaptive response generation"@en ;
    hi:allowsTask <http://example.org/hi/leapspace/Task/s2_at02> .

<http://example.org/hi/leapspace/Capability/international_local_funding_coverage> a hi:Capability ;
    rdfs:label "international/local funding coverage"@en ;
    hi:allowsTask <http://example.org/hi/leapspace/Task/s6_at02> .

<http://example.org/hi/leapspace/Capability/literature_grounded_fact_checking> a hi:Capability ;
    rdfs:label "literature-grounded fact-checking"@en ;
    hi:allowsTask <http://example.org/hi/leapspace/Task/s7_at02> .

<http://example.org/hi/leapspace/Capability/mandatory_citation_enforcement> a hi:Capability ;
    rdfs:label "mandatory citation enforcement"@en .

<http://example.org/hi/leapspace/Goal/s1_goal> a hi:Goal ;
    rdfs:label "Keep a literature review current despite rapidly growing publication volume"@en ;
    rdfs:comment "Keep a literature review current despite rapidly growing publication volume"@en ;
    hi:requiresTask <http://example.org/hi/leapspace/Task/s1_at01>,
        <http://example.org/hi/leapspace/Task/s1_at02>,
        <http://example.org/hi/leapspace/Task/s1_at03>,
        <http://example.org/hi/leapspace/Task/s1_ht01>,
        <http://example.org/hi/leapspace/Task/s1_ht02>,
        <http://example.org/hi/leapspace/Task/s1_ht03> .

<http://example.org/hi/leapspace/Goal/s2_goal> a hi:Goal ;
    rdfs:label "Rapidly build foundational understanding of a new research area without prior domain expertise"@en ;
    rdfs:comment "Rapidly build foundational understanding of a new research area without prior domain expertise"@en ;
    hi:requiresTask <http://example.org/hi/leapspace/Task/s2_at01>,
        <http://example.org/hi/leapspace/Task/s2_at02>,
        <http://example.org/hi/leapspace/Task/s2_ht01>,
        <http://example.org/hi/leapspace/Task/s2_ht02> .

<http://example.org/hi/leapspace/Goal/s3_goal> a hi:Goal ;
    rdfs:label "Synthesize scattered multidisciplinary evidence and surface previously unrecognized research gaps"@en ;
    rdfs:comment "Synthesize scattered multidisciplinary evidence and surface previously unrecognized research gaps"@en ;
    hi:requiresTask <http://example.org/hi/leapspace/Task/s3_at01>,
        <http://example.org/hi/leapspace/Task/s3_at02>,
        <http://example.org/hi/leapspace/Task/s3_at03>,
        <http://example.org/hi/leapspace/Task/s3_ht01>,
        <http://example.org/hi/leapspace/Task/s3_ht02>,
        <http://example.org/hi/leapspace/Task/s3_ht03> .

<http://example.org/hi/leapspace/Goal/s4_goal> a hi:Goal ;

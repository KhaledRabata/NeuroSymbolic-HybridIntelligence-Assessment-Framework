        <http://example.org/hi/linkedin/HumanAgent/recruiter> ;
    hi:isInfluencedBy <http://example.org/hi/linkedin/Context/s5_context> .

<http://example.org/hi/linkedin/HITeam/s6_team> a hi:HITeam ;
    rdfs:label "S6 — Recruiter-Hiring Manager Collaborative Decision Making — HI Team"@en ;
    meta:careCharacteristics "Collaborative (core human-human collaboration facilitated by AI); Adaptive (AI summaries adapt to candidate data; system adapts from post-decision recruiter actions); Responsible (final decision human-only; accountability clear); Explainable (AI summaries provide transparent evidence for hiring manager)"@en ;
    hi:hasGoal <http://example.org/hi/linkedin/Goal/s6_goal> ;
    hi:hasMember <http://example.org/hi/linkedin/ArtificialAgent/ai_follow_up>,

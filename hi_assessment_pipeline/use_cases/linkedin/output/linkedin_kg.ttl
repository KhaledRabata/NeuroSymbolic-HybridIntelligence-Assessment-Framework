        <http://example.org/hi/linkedin/HumanAgent/linkedin_responsible_ai_team>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> ;
    hi:isInfluencedBy <http://example.org/hi/linkedin/Context/s4_context> .

<http://example.org/hi/linkedin/HITeam/s5_team> a hi:HITeam ;
    rdfs:label "S5 — Explainable AI-Assisted Search — HI Team"@en ;
    meta:careCharacteristics "Collaborative (recruiter provides intent; AI handles formalisation and ranking); Adaptive (Skills Graph updated continuously; models improve from recruiter signals); Responsible (blocked from sensitive personal data results; equal treatment tested); Explainable (primary explainability scenario: match/gap visible; filter shown; suggestions provided)"@en ;
    hi:hasGoal <http://example.org/hi/linkedin/Goal/s5_goal> ;
    hi:hasMember <http://example.org/hi/linkedin/ArtificialAgent/advanced_ai_assisted_search>,
        <http://example.org/hi/linkedin/ArtificialAgent/galene_search_engine>,

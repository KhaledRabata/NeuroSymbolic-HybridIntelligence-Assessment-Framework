@prefix hi: <https://w3id.org/hi-ontology#> .
@prefix meta: <http://example.org/hi/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/hi/linkedin/UseCase/s1> a hi:UseCase ;
    rdfs:label "S1 — AI-Assisted Candidate Sourcing"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-001, E-002, E-005, E-006, E-007, E-008, E-010, E-012, E-013, E-014, E-023, E-024, E-025, E-027, E-028, E-041, E-042, E-043, E-044, E-045, E-046"@en ;
    meta:observedInferred "Core facts Observed; HLTM integration with sourcing Observed (E-046); continuous background search Observed (E-005)"@en ;
    hi:hasHITeam <http://example.org/hi/linkedin/HITeam/s1_team> .

<http://example.org/hi/linkedin/UseCase/s2> a hi:UseCase ;
    rdfs:label "S2 — AI-Driven Candidate Evaluation"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-002, E-005, E-013, E-014, E-015, E-016, E-019, E-020, E-033, E-034, E-035, E-046"@en ;
    meta:observedInferred "Core facts Observed; RSC+ data types Observed (E-020); evidence-citation mechanism Observed (E-012/E-013)"@en ;
    hi:hasHITeam <http://example.org/hi/linkedin/HITeam/s2_team> .

<http://example.org/hi/linkedin/UseCase/s3> a hi:UseCase ;
    rdfs:label "S3 — Automated Prescreening via InMail"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-001, E-002, E-005, E-012, E-013, E-030, E-031, E-032, E-038"@en ;
    meta:observedInferred "Core prescreening workflow Observed; InMail metrics Observed; candidate AI disclosure not documented (GAP E-GAP-02)"@en ;
    hi:hasHITeam <http://example.org/hi/linkedin/HITeam/s3_team> .

<http://example.org/hi/linkedin/UseCase/s4> a hi:UseCase ;
    rdfs:label "S4 — Fairness-Aware Representative Candidate Ranking"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-009, E-010, E-017, E-018, E-019, E-020, E-041, E-047"@en ;
    meta:observedInferred "Fairness system and deployment Observed (E-010; E-041); LiFT mechanism Observed (E-017; E-018); 100% rollout Observed (E-010)"@en ;
    hi:hasHITeam <http://example.org/hi/linkedin/HITeam/s4_team> .

<http://example.org/hi/linkedin/UseCase/s5> a hi:UseCase ;
    rdfs:label "S5 — Explainable AI-Assisted Search"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-006, E-008, E-011, E-019, E-020, E-023, E-024, E-041, E-042"@en ;
    meta:observedInferred "NL search feature Observed; qualification match/gap display Observed (E-020); XAI suggestions Observed (E-011)"@en ;
    hi:hasHITeam <http://example.org/hi/linkedin/HITeam/s5_team> .

<http://example.org/hi/linkedin/UseCase/s6> a hi:UseCase ;
    rdfs:label "S6 — Recruiter-Hiring Manager Collaborative Decision Making"@en ;
    meta:confidence "Medium-High"@en ;
    meta:evidenceIDs "E-002, E-005, E-019, E-020, E-039, E-040"@en ;
    meta:observedInferred "Teams integration Observed (E-002; E-005); profile sharing Observed (E-039); collaboration dynamics partially Inferred"@en ;
    hi:hasHITeam <http://example.org/hi/linkedin/HITeam/s6_team> .

<http://example.org/hi/linkedin/UseCase/s7> a hi:UseCase ;
    rdfs:label "S7 — Long-Term Personalisation via HLTM"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-008, E-027, E-044, E-046"@en ;
    meta:observedInferred "HLTM paper Observed (E-046); production deployment Observed (E-046); 5-10% metric Observed (E-046)"@en ;
    hi:hasHITeam <http://example.org/hi/linkedin/HITeam/s7_team> .

<http://example.org/hi/linkedin/UseCase/s8> a hi:UseCase ;
    rdfs:label "S8 — ATS Integration and Unified Applicant Management (RSC+)"@en ;
    meta:confidence "High"@en ;
    meta:evidenceIDs "E-019, E-020, E-033, E-034, E-035"@en ;
    meta:observedInferred "RSC+ data types and access Observed (E-020); time savings Observed (E-033); automated stage syncing as opt-in Observed (E-020)"@en ;
    hi:hasHITeam <http://example.org/hi/linkedin/HITeam/s8_team> .

<http://example.org/hi/linkedin/kg> a owl:Ontology ;
    rdfs:label "HI Knowledge Graph — Linkedin"@en ;
    rdfs:comment "ABox for the 'linkedin' use case, generated by kg_builder.py from the Phase 1 extraction sheet TBox imported from the HI Ontology (https://w3id.org/hi-ontology#)"@en ;
    owl:imports hi: .

<http://example.org/hi/linkedin/Evaluation/s1_evaluation> a hi:Evaluation ;
    rdfs:label "S1 — AI-Assisted Candidate Sourcing — Evaluation"@en ;
    meta:hasDecisionPoint "Recruiter selects which candidates to contact (human only); recruiter refines qualifications; recruiter chooses to enable HA for project"@en ;
    meta:hasFeedbackMechanism "Recruiter view/contact/archive → offline model retraining; HLTM stores preferences across sessions; in-session personalisation"@en ;
    hi:hasMetricConcept <http://example.org/hi/linkedin/Metric/candidate_shortlist_quality>,
        <http://example.org/hi/linkedin/Metric/profiles_reviewed_per_hire>,
        <http://example.org/hi/linkedin/Metric/representative_ranking_coverage>,
        <http://example.org/hi/linkedin/Metric/time_saved_per_role> .

<http://example.org/hi/linkedin/Evaluation/s2_evaluation> a hi:Evaluation ;
    rdfs:label "S2 — AI-Driven Candidate Evaluation — Evaluation"@en ;
    meta:hasDecisionPoint "Recruiter advances or archives each candidate (human only); recruiter overrides AI assessment; recruiter chooses to use RSC+ Connected Projects"@en ;
    meta:hasFeedbackMechanism "Recruiter advance/archive → model retraining; HLTM updates from session; hallucination rate monitoring (internal)"@en ;
    hi:hasMetricConcept <http://example.org/hi/linkedin/Metric/candidate_summary_accuracy>,
        <http://example.org/hi/linkedin/Metric/negative_feedback_rate>,
        <http://example.org/hi/linkedin/Metric/profiles_reviewed_per_hire> .

<http://example.org/hi/linkedin/Evaluation/s3_evaluation> a hi:Evaluation ;
    rdfs:label "S3 — Automated Prescreening via InMail — Evaluation"@en ;
    meta:hasDecisionPoint "Recruiter defines prescreening questions; recruiter reviews/edits InMail draft; recruiter decides which candidates passed prescreening; recruiter advances to interview"@en ;
    meta:hasFeedbackMechanism "Recruiter thumbs up/down on InMail draft → refines message model; InMail acceptance/response rates (implicit model signal); recruiter advance/archive after prescreening → retraining signal"@en ;
    hi:hasMetricConcept <http://example.org/hi/linkedin/Metric/39_automated_follow_ups>,
        <http://example.org/hi/linkedin/Metric/55_ai_assisted_messages>,
        <http://example.org/hi/linkedin/Metric/inmail_acceptance_rate_66_ha_vs_traditional>,
        <http://example.org/hi/linkedin/Metric/time_saved_in_applicant_identification> .

<http://example.org/hi/linkedin/Evaluation/s4_evaluation> a hi:Evaluation ;
    rdfs:label "S4 — Fairness-Aware Representative Candidate Ranking — Evaluation"@en ;
    meta:hasDecisionPoint "LinkedIn Responsible AI Team: defines qualified population and protected attributes; decides whether to retrain/deramp model. Recruiter: makes final contact decisions"@en ;
    meta:hasFeedbackMechanism "LiFT continuous monitoring (recurring bias audits); recruiter contact patterns monitored for emergent bias; offline model retraining cycle with updated fairness constraints"@en ;
    hi:hasMetricConcept <http://example.org/hi/linkedin/Metric/bias_detection_rate>,
        <http://example.org/hi/linkedin/Metric/gender_representation_ratio_in_top_k_vs_qualified_population>,
        <http://example.org/hi/linkedin/Metric/inmail_acceptance_rate>,
        <http://example.org/hi/linkedin/Metric/representative_ranking_coverage> .

<http://example.org/hi/linkedin/Evaluation/s5_evaluation> a hi:Evaluation ;
    rdfs:label "S5 — Explainable AI-Assisted Search — Evaluation"@en ;
    meta:hasDecisionPoint "Recruiter accepts or modifies AI-suggested filter interpretation; recruiter expands/narrows search criteria based on explanations; recruiter selects candidates to contact"@en ;
    meta:hasFeedbackMechanism "Recruiter contact actions → implicit model improvement signal; filter adjustment patterns → NL query parsing improvement (Inferred)"@en ;
    hi:hasMetricConcept <http://example.org/hi/linkedin/Metric/filter_interpretation_accuracy>,
        <http://example.org/hi/linkedin/Metric/search_result_quality>,
        <http://example.org/hi/linkedin/Metric/time_to_first_qualified_contact> .

<http://example.org/hi/linkedin/Evaluation/s6_evaluation> a hi:Evaluation ;
    rdfs:label "S6 — Recruiter-Hiring Manager Collaborative Decision Making — Evaluation"@en ;
    meta:hasDecisionPoint "Hiring Manager: final hiring decision (human-only; explicitly non-autonomous); Recruiter: which candidates to advance to hiring manager review; Recruiter: how to synthesise conflicting feedback"@en ;
    meta:hasFeedbackMechanism "Hiring manager interview feedback stored in ATS/Recruiter notes; recruiter advance/reject decisions → model retraining signal"@en ;
    hi:hasMetricConcept <http://example.org/hi/linkedin/Metric/alignment_between_recruiter_and_hiring_manager>,
        <http://example.org/hi/linkedin/Metric/hiring_manager_satisfaction_with_candidate_quality>,
        <http://example.org/hi/linkedin/Metric/no_explicit_metric_documented>,
        <http://example.org/hi/linkedin/Metric/time_from_shortlist_to_hiring_decision_inferred> .

<http://example.org/hi/linkedin/Evaluation/s7_evaluation> a hi:Evaluation ;
    rdfs:label "S7 — Long-Term Personalisation via HLTM — Evaluation"@en ;
    meta:hasDecisionPoint "Recruiter accepts or overrides HLTM-inferred preferences; LinkedIn Engineering/Privacy defines HLTM scope boundaries (seat/project level)"@en ;
    meta:hasFeedbackMechanism "Recruiter actions (advance/archive/contact) in current session → HLTM update; continuous: every session feeds forward into future personalisation"@en ;
    hi:hasMetricConcept <http://example.org/hi/linkedin/Metric/negative_feedback_rate_reduction>,
        <http://example.org/hi/linkedin/Metric/recruiter_re_specification_rate>,
        <http://example.org/hi/linkedin/Metric/session_start_to_first_qualified_candidate_time> .

<http://example.org/hi/linkedin/Evaluation/s8_evaluation> a hi:Evaluation ;
    rdfs:label "S8 — ATS Integration and Unified Applicant Management (RSC+) — Evaluation"@en ;
    meta:hasDecisionPoint "Recruiter Admin: whether to enable RSC+. Recruiter: link project to ATS requisition; all applicant advancement/rejection decisions (human-only). Customer: whether to enable automated stage syncing (opt-in)"@en ;
    meta:hasFeedbackMechanism "Recruiter actions in unified view → model retraining signals; ATS stage data → signals for future candidate pipeline modelling (Inferred)"@en ;
    hi:hasMetricConcept <http://example.org/hi/linkedin/Metric/applicant_coverage_rate>,
        <http://example.org/hi/linkedin/Metric/inmail_acceptance_rate_increase_with_rsc>,
        <http://example.org/hi/linkedin/Metric/recruiter_time_saved_with_rsc_active> .

<http://example.org/hi/linkedin/Interaction/s1_int01> a hi:Interaction ;
    rdfs:label "Recruiter ↔ Hiring Assistant (NL dialogue)"@en ;
    rdfs:comment "NL dialogue"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s1_int02> a hi:Interaction ;
    rdfs:label "Hiring Assistant → Recruiter (ranked shortlist)"@en ;
    rdfs:comment "ranked shortlist"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s1_int03> a hi:Interaction ;
    rdfs:label "Recruiter → Model (implicit feedback via actions)"@en ;
    rdfs:comment "implicit feedback via actions"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/ranking_model>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s2_int01> a hi:Interaction ;
    rdfs:label "Hiring Assistant → Recruiter (evaluation summaries)"@en ;
    rdfs:comment "evaluation summaries"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s2_int02> a hi:Interaction ;
    rdfs:label "Recruiter ↔ Hiring Assistant (qualification refinement)"@en ;
    rdfs:comment "qualification refinement"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s2_int03> a hi:Interaction ;
    rdfs:label "Recruiter → Hiring Manager (profile sharing, optional)"@en ;
    rdfs:comment "profile sharing, optional"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/HumanAgent/hiring_manager>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s2_int04> a hi:Interaction ;
    rdfs:label "Recruiter → Model (advance/archive as training signal)"@en ;
    rdfs:comment "advance/archive as training signal"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/eon_model>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s3_int01> a hi:Interaction ;
    rdfs:label "Hiring Assistant → Candidate (personalised InMail)"@en ;
    rdfs:comment "personalised InMail"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/candidate> .

<http://example.org/hi/linkedin/Interaction/s3_int02> a hi:Interaction ;
    rdfs:label "Candidate → Hiring Assistant (replies/responses)"@en ;
    rdfs:comment "replies/responses"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/candidate> .

<http://example.org/hi/linkedin/Interaction/s3_int03> a hi:Interaction ;
    rdfs:label "Hiring Assistant → Candidate (prescreening questions + role answers)"@en ;
    rdfs:comment "prescreening questions + role answers"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/candidate> .

<http://example.org/hi/linkedin/Interaction/s3_int04> a hi:Interaction ;
    rdfs:label "Hiring Assistant → Recruiter (aggregated results)"@en ;
    rdfs:comment "aggregated results"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s3_int05> a hi:Interaction ;
    rdfs:label "Recruiter ↔ Hiring Assistant (monitoring)"@en ;
    rdfs:comment "monitoring"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s4_int01> a hi:Interaction ;
    rdfs:label "LiFT → Responsible AI Team (automated bias reports)"@en ;
    rdfs:comment "automated bias reports"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/HumanAgent/linkedin_responsible_ai_team>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s4_int02> a hi:Interaction ;
    rdfs:label "Responsible AI Team → Engineering (trigger retraining/model demotion)"@en ;
    rdfs:comment "trigger retraining/model demotion"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/HumanAgent/linkedin_responsible_ai_team>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s4_int03> a hi:Interaction ;
    rdfs:label "Ranking System → Recruiter (delivers re-ranked results transparently)"@en ;
    rdfs:comment "delivers re-ranked results transparently"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/representative_ranking_system>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s5_int01> a hi:Interaction ;
    rdfs:label "Recruiter → AI-Assisted Search (NL query)"@en ;
    rdfs:comment "NL query"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/advanced_ai_assisted_search>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s5_int02> a hi:Interaction ;
    rdfs:label "AI-Assisted Search → Recruiter (results + filter breakdown + match/gap)"@en ;
    rdfs:comment "results + filter breakdown + match/gap"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/advanced_ai_assisted_search>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s5_int03> a hi:Interaction ;
    rdfs:label "AI-Assisted Search → Recruiter (suggested filter adjustments)"@en ;
    rdfs:comment "suggested filter adjustments"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/advanced_ai_assisted_search>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .


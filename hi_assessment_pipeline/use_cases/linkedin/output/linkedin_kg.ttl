<http://example.org/hi/linkedin/HITeam/s2_team> a hi:HITeam ;
    rdfs:label "S2 — AI-Driven Candidate Evaluation — HI Team"@en ;
    meta:careCharacteristics "Collaborative (AI handles volume evaluation; human decides); Adaptive (HLTM; model retraining); Responsible (no sensitive data in evaluation; no autonomous decisions; bias auditing); Explainable (evidence-cited summaries; match/gap visible)"@en ;
    hi:hasGoal <http://example.org/hi/linkedin/Goal/s2_goal> ;
    hi:hasMember <http://example.org/hi/linkedin/ArtificialAgent/eon_model>,

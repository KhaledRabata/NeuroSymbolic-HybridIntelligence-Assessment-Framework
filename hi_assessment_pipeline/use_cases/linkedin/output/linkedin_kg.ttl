<http://example.org/hi/linkedin/HITeam/s7_team> a hi:HITeam ;
    rdfs:label "S7 — Long-Term Personalisation via HLTM — HI Team"@en ;
    meta:careCharacteristics "Collaborative (HLTM enables smoother human-AI collaboration by reducing re-specification burden); Adaptive (primary adaptivity scenario; explicit cross-session learning); Responsible (memory scoped to privacy boundaries; no cross-customer contamination); Explainable (PARTIAL — HLTM inferences not surfaced as explicit explanations; identified as gap E-GAP-04)"@en ;
    hi:hasGoal <http://example.org/hi/linkedin/Goal/s7_goal> ;
    hi:hasMember <http://example.org/hi/linkedin/ArtificialAgent/evaluation_agent>,

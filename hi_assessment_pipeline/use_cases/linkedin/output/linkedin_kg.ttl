    hi:isInfluencedBy <http://example.org/hi/linkedin/Context/s3_context> .

<http://example.org/hi/linkedin/HITeam/s4_team> a hi:HITeam ;
    rdfs:label "S4 — Fairness-Aware Representative Candidate Ranking — HI Team"@en ;
    meta:careCharacteristics "Collaborative (AI team + ranking AI maintain fairness; recruiter benefits); Adaptive (recurring LiFT audits + model retraining); Responsible (core responsibility scenario; fairness by design; protected attribute compliance); Explainable (fairness documented publicly; KDD paper; AI transparency page)"@en ;
    hi:hasGoal <http://example.org/hi/linkedin/Goal/s4_goal> ;
    hi:hasMember <http://example.org/hi/linkedin/ArtificialAgent/fair_model_analyser>,
        <http://example.org/hi/linkedin/ArtificialAgent/linkedin_fairness_toolkit>,

<http://example.org/hi/linkedin/HITeam/s3_team> a hi:HITeam ;
    rdfs:label "S3 — Automated Prescreening via InMail — HI Team"@en ;
    meta:careCharacteristics "Collaborative (HA handles volume Q&A; recruiter handles final judgement); Adaptive (message model retrains from feedback; follow-ups adapt to non-response); Responsible (recruiter defines questions; no autonomous advancement); Explainable (prescreening results transparent; full Q&A available)"@en ;
    hi:hasGoal <http://example.org/hi/linkedin/Goal/s3_goal> ;
    hi:hasMember <http://example.org/hi/linkedin/ArtificialAgent/ai_assisted_messages>,
        <http://example.org/hi/linkedin/ArtificialAgent/automated_follow_up_system>,

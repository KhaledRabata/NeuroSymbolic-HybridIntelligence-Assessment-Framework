<http://example.org/hi/linkedin/Interaction/s6_int03> a hi:Interaction ;
    rdfs:label "Hiring Manager → Recruiter (structured interview feedback)"@en ;
    rdfs:comment "structured interview feedback"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/HumanAgent/hiring_manager>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s7_int01> a hi:Interaction ;
    rdfs:label "Hiring Assistant → Recruiter (personalised recommendations without explicit re-specification)"@en ;
    rdfs:comment "personalised recommendations without explicit re-specification"@en ;
    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/hiring_assistant>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Interaction/s7_int02> a hi:Interaction ;
    rdfs:label "Recruiter → HLTM (implicit feedback via advance/archive actions updates long-term preferences)"@en ;

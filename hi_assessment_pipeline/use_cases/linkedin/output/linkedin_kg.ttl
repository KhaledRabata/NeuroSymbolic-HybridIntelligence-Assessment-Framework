    hi:hasAgentInvolved <http://example.org/hi/linkedin/ArtificialAgent/ats_sync_module>,
        <http://example.org/hi/linkedin/HumanAgent/recruiter> .

<http://example.org/hi/linkedin/Metric/39_automated_follow_ups> a skos:Concept ;
    skos:prefLabel "+39% automated follow-ups)"@en .

<http://example.org/hi/linkedin/Metric/55_ai_assisted_messages> a skos:Concept ;
    skos:prefLabel "+55% AI-assisted messages"@en .

<http://example.org/hi/linkedin/Metric/alignment_between_recruiter_and_hiring_manager> a skos:Concept ;
    skos:prefLabel "alignment between recruiter and hiring manager (Inferred)"@en .

<http://example.org/hi/linkedin/Metric/applicant_coverage_rate> a skos:Concept ;
    skos:prefLabel "applicant coverage rate (Inferred)"@en .

<http://example.org/hi/linkedin/Metric/bias_detection_rate> a skos:Concept ;
    skos:prefLabel "bias detection rate (LiFT)"@en .

<http://example.org/hi/linkedin/Metric/candidate_shortlist_quality> a skos:Concept ;
    skos:prefLabel "candidate shortlist quality"@en .

<http://example.org/hi/linkedin/Metric/candidate_summary_accuracy> a skos:Concept ;
    skos:prefLabel "candidate summary accuracy (hallucination testing)"@en .

<http://example.org/hi/linkedin/Metric/filter_interpretation_accuracy> a skos:Concept ;
    skos:prefLabel "filter interpretation accuracy (internal evaluation)"@en .

<http://example.org/hi/linkedin/Metric/gender_representation_ratio_in_top_k_vs_qualified_population> a skos:Concept ;
    skos:prefLabel "gender representation ratio in top-K vs. qualified population"@en .

<http://example.org/hi/linkedin/Metric/hiring_manager_satisfaction_with_candidate_quality> a skos:Concept ;
    skos:prefLabel "hiring manager satisfaction with candidate quality (Inferred)"@en .

<http://example.org/hi/linkedin/Metric/inmail_acceptance_rate> a skos:Concept ;
    skos:prefLabel "InMail acceptance rate (must not be harmed by fairness constraint)"@en .

<http://example.org/hi/linkedin/Metric/inmail_acceptance_rate_66_ha_vs_traditional> a skos:Concept ;
    skos:prefLabel "InMail acceptance rate (+66% HA vs traditional"@en .

<http://example.org/hi/linkedin/Metric/inmail_acceptance_rate_increase_with_rsc> a skos:Concept ;
    skos:prefLabel "InMail acceptance rate increase with RSC (7%)"@en .

<http://example.org/hi/linkedin/Metric/negative_feedback_rate> a skos:Concept ;
    skos:prefLabel "negative feedback rate (-5-10% with HLTM)"@en .

<http://example.org/hi/linkedin/Metric/negative_feedback_rate_reduction> a skos:Concept ;
    skos:prefLabel "Negative feedback rate reduction (5-10% measured in production)"@en .

<http://example.org/hi/linkedin/Metric/no_explicit_metric_documented> a skos:Concept ;
    skos:prefLabel "no explicit metric documented)"@en .

<http://example.org/hi/linkedin/Metric/recruiter_re_specification_rate> a skos:Concept ;
    skos:prefLabel "recruiter re-specification rate (Inferred)"@en .

<http://example.org/hi/linkedin/Metric/recruiter_time_saved_with_rsc_active> a skos:Concept ;
    skos:prefLabel "Recruiter time saved with RSC active (3.5 hours/week)"@en .

<http://example.org/hi/linkedin/Metric/search_result_quality> a skos:Concept ;
    skos:prefLabel "Search result quality (implicit via recruiter contact actions)"@en .

<http://example.org/hi/linkedin/Metric/session_start_to_first_qualified_candidate_time> a skos:Concept ;
    skos:prefLabel "session start to first qualified candidate time (Inferred)"@en .

